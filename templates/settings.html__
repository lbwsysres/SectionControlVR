<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Настройки Агро-Системы</title>
    <style>
        :root {
            --bg-main: #0a0a0a;
            --bg-card: #181818;
            --accent: #2ecc71;
            --text: #e0e0e0;
            --border: #333;
            --btn-gray: #2c2c2c;
            --danger: #e74c3c;
            --hw-green: #2ecc71;
            --hw-orange: #f39c12;
        }
        body {
            background-color: var(--bg-main);
            color: var(--text);
            font-family: 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            user-select: none;
            overflow-x: hidden;
            padding: 20px 40px 120px 40px;
        }
        /* Навигация табами */
        .tabs-nav {
            display: flex;
            gap: 5px;
            margin-bottom: 15px;
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--bg-main);
            padding-bottom: 10px;
        }
        .tab-link {
            flex: 1;
            padding: 15px 5px;
            background: var(--bg-card);
            border: 2px solid var(--border);
            color: #666;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: bold;
            transition: 0.2s;
            cursor: pointer;
        }
        .tab-link.active {
            border-color: var(--accent);
            color: var(--accent);
            background: #1a2a1f;
        }
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }
        /* Карточки */
        .card {
            background: var(--bg-card);
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid var(--border);
        }
        h2 {
            margin: 0 0 15px 0;
            font-size: 1rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        /* Тач-спиннеры (+ / -) */
        .touch-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .label-box {
            flex: 1;
            padding-right: 10px;
        }
        .label-main {
            display: block;
            font-size: 1rem;
            font-weight: 500;
        }
        .label-hint {
            font-size: 0.8rem;
            color: #666;
        }
        .spinner {
            display: flex;
            align-items: center;
            background: #000;
            border-radius: 10px;
            padding: 4px;
        }
        .spinner button {
            width: 60px;
            height: 60px;
            background: var(--btn-gray);
            border: none;
            color: white;
            font-size: 1.4rem;
            border-radius: 8px;
            cursor: pointer;
        }
        .spinner button:active {
            background: #444;
        }
        .spinner span {
            min-width: 60px;
            text-align: center;
            font-size: 1.2rem;
            font-weight: bold;
        }
        /* Красивые селекторы для заліза */
        .hw-select {
            background: #000;
            color: var(--accent);
            border: 2px solid var(--border);
            height: 60px;
            width: 150px;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: bold;
            text-align: center;
            outline: none;
            cursor: pointer;
        }
        .hw-select option {
            background: var(--bg-card);
            color: white;
        }
        /* Список секций */
        .section-item {
            display: flex;
            align-items: center;
            background: #222;
            margin-bottom: 8px;
            padding: 8px;
            border-radius: 10px;
            gap: 10px;
        }
        .btn-del {
            width: 45px;
            height: 45px;
            background: var(--danger);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }
        /* Переключатель (Toggle) */
        .switch {
            position: relative;
            display: inline-block;
            width: 80px;
            height: 34px;
        }
        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .slider-round {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }
        .slider-round:before {
            position: absolute;
            content: "";
            height: 26px; width: 26px;
            left: 4px; bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        input: checked + .slider-round {
            background-color: var(--accent);
        }
        input: checked + .slider-round:before {
            transform: translateX(36px);
        }
        /* Большой слайдер */
        .slider {
            -webkit-appearance: none;
            width: 100%;
            height: 40px;
            background: #222;
            border-radius: 20px;
            outline: none;
            margin-top: 10px;
        }
        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-radius: 50%;
            border: 3px solid #fff;
        }
        /* Модалка */
        #customModal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        .modal-card {
            background: #1e1e1e;
            width: 80%;
            max-width: 500px;
            padding: 40px 30px;
            border-radius: 20px;
            border-top: 8px solid #c0392b;
            text-align: center;
            box-shadow: 0 10px 50px rgba(0, 0, 0, 0.8);
        }
    </style>
</head>
<body>

    <div class="tabs-nav">
        <button class="tab-link active" onclick="openTab(event, 'tab1')">ШТАНГА</button>
        <button class="tab-link" onclick="openTab(event, 'tab2')">АВТО</button>
        <button class="tab-link" onclick="openTab(event, 'tab3')">СИСТЕМА</button>
    </div>

    <!-- ТАБ 1: ШТАНГА -->
    <div id="tab1" class="tab-content active">
        <div class="card">
            <h2>Конфігурація секцій (м)</h2>
            <div id="sec-list"></div>
            <button onclick="addSec()" style="width:100%; padding:15px; background:transparent; color:var(--accent); border:2px dashed var(--accent); border-radius:10px; margin-top:10px; font-weight: bold; cursor: pointer;">
                + ДОБАВИТЬ СЕКЦИЮ
            </button>
        </div>
    </div>

    <!-- ТАБ 2: АВТОМАТИКА -->
    <div id="tab2" class="tab-content">
        <div class="card">
            <h2>Перекриття</h2>
            <div class="slider-box">
                <div class="touch-row">
                    <span class="label-main">Мінімальне перекриття</span>
                    <b id="overlap_label" style="color:var(--accent)">{{ (cfg.AUTO_SECTION_MIN_OVERLAP * 100)|int }}%</b>
                </div>
                <input type="range" class="slider" id="c_overlap" min="0" max="1" step="0.05" value="{{ cfg.AUTO_SECTION_MIN_OVERLAP }}" oninput="updateOverlap(this.value)">
            </div>
            <div class="touch-row">
                <span class="label-main">Look Ahead (сек)</span>
                <div class="spinner">
                    <button onclick="change('c_look', -0.1)">-</button>
                    <span id="c_look">{{ cfg.LOOK_AHEAD_TIME }}</span>
                    <button onclick="change('c_look', 0.1)">+</button>
                </div>
            </div>
            <div class="touch-row">
                <span class="label-main">Buffer (м)</span>
                <div class="spinner">
                    <button onclick="change('c_buf', -0.01)">-</button>
                    <span id="c_buf">{{ cfg.AUTO_SECTION_BUFFER }}</span>
                    <button onclick="change('c_buf', 0.01)">+</button>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Криві та RTK</h2>
            <div class="slider-box">
                <div class="touch-row">
                    <span class="label-main">Плавність фільтра</span>
                    <b id="smooth_label" style="color:var(--accent)">{{ cfg.CURVE_COMP_SMOOTH }}</b>
                </div>
                <input type="range" class="slider" id="c_smooth" min="0.1" max="1" step="0.1" value="{{ cfg.CURVE_COMP_SMOOTH }}" oninput="updateSmooth(this.value)">
            </div>
            <div class="touch-row">
                <span class="label-main">Мін. RTK статус</span>
                <div class="spinner">
                    <button onclick="change('c_rtk', -1)">-</button>
                    <span id="c_rtk">{{ cfg.CURVE_COMP_MIN_RTK }}</span>
                    <button onclick="change('c_rtk', 1)">+</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ТАБ 3: СИСТЕМА -->
    <div id="tab3" class="tab-content">
        <!-- 🔥 НОВАЯ КАРТОЧКА: НАСТРОЙКИ ГЕО-ПРИЕМНИКА (GPS) -->
        <div class="card" style="border-left: 5px solid var(--hw-orange);">
            <h2 style="color: var(--hw-orange)">📡 НАСТРОЙКИ ПРИЕМНИКА GPS</h2>
            <div class="touch-row">
                <span class="label-main">Аппаратный GPS приемник</span>
                <label class="switch">
                    <input type="checkbox" id="c_gps_enable" {{ 'checked' if cfg.GPS_ENABLE else '' }}>
                    <span class="slider-round"></span>
                </label>
            </div>
            <div class="touch-row">
                <div class="label-box">
                    <span class="label-main">Порт подключения</span>
                    <span class="label-hint">Имя порта для Windows (COM) или Linux (/dev/)</span>
                </div>
                <select id="c_gps_port" class="hw-select">
                    <!-- Популярные порты для кроссплатформенности -->
                    <option value="com1" {{ 'selected' if cfg.GPS_PORT == 'com1' else '' }}>COM1</option>
                    <option value="com3" {{ 'selected' if cfg.GPS_PORT == 'com3' else '' }}>COM3</option>
                    <option value="com4" {{ 'selected' if cfg.GPS_PORT == 'com4' else '' }}>COM4</option>
                    <option value="/dev/ttyUSB0" {{ 'selected' if cfg.GPS_PORT == '/dev/ttyUSB0' else '' }}>ttyUSB0</option>
                    <option value="/dev/ttyAMA0" {{ 'selected' if cfg.GPS_PORT == '/dev/ttyAMA0' else '' }}>ttyAMA0</option>
                    <option value="/dev/ttyACM0" {{ 'selected' if cfg.GPS_PORT == '/dev/ttyACM0' else '' }}>ttyACM0</option>
                </select>
            </div>
            <div class="touch-row">
                <span class="label-main">Скорость порта (Baudrate)</span>
                <select id="c_gps_speed" class="hw-select">
                    <option value="9600" {{ 'selected' if cfg.GPS_PORT_SPEED == 9600 else '' }}>9600 (NEO-6)</option>
                    <option value="38400" {{ 'selected' if cfg.GPS_PORT_SPEED == 38400 else '' }}>38400</option>
                    <option value="115200" {{ 'selected' if cfg.GPS_PORT_SPEED == 115200 else '' }}>115200 (F9P)</option>
                </select>
            </div>
            <div class="touch-row">
                <span class="label-main">Таймаут коннекта (мс)</span>
                <div class="spinner">
                    <button onclick="change('c_gps_reconnect', -500)">-</button>
                    <span id="c_gps_reconnect">{{ cfg.GPS_TIME_RECONNECT }}</span>
                    <button onclick="change('c_gps_reconnect', 500)">+</button>
                </div>
            </div>
        </div>

        <!-- 🔥 НОВАЯ КАРТОЧКА: НАСТРОЙКИ КОНТРОЛЛЕРА СЕКЦИЙ (BOARD) -->
        <div class="card" style="border-left: 5px solid var(--hw-green);">
            <h2 style="color: var(--hw-green)">🎛️ ПЛАТА УПРАВЛЕНИЯ КЛАПАНАМИ</h2>
            <div class="touch-row">
                <span class="label-main">Выдача команд на реле</span>
                <label class="switch">
                    <input type="checkbox" id="c_board_enable" {{ 'checked' if cfg.CONTROL_BOARD_ENABLE else '' }}>
                    <span class="slider-round"></span>
                </label>
            </div>
            <div class="touch-row">
                <span class="label-main">Порт контроллера</span>
                <select id="c_board_port" class="hw-select">
                    <option value="com2" {{ 'selected' if cfg.CONTROL_BOARD_PORT == 'com2' else '' }}>COM2</option>
                    <option value="com5" {{ 'selected' if cfg.CONTROL_BOARD_PORT == 'com5' else '' }}>COM5</option>
                    <option value="/dev/ttyUSB1" {{ 'selected' if cfg.CONTROL_BOARD_PORT == '/dev/ttyUSB1' else '' }}>ttyUSB1</option>
                    <option value="/dev/ttyACM1" {{ 'selected' if cfg.CONTROL_BOARD_PORT == '/dev/ttyACM1' else '' }}>ttyACM1</option>
                </select>
            </div>
            <div class="touch-row">
                <span class="label-main">Скорость порта (Baudrate)</span>
                <select id="c_board_speed" class="hw-select">
                    <option value="9600" {{ 'selected' if cfg.CONTROL_BOARD_PORT_SPEED == 9600 else '' }}>9600</option>
                    <option value="115200" {{ 'selected' if cfg.CONTROL_BOARD_PORT_SPEED == 115200 else '' }}>115200</option>
                </select>
            </div>
            <div class="touch-row">
                <span class="label-main">Интервал пинга заліза (мс)</span>
                <div class="spinner">
                    <button onclick="change('c_board_reconnect', -500)">-</button>
                    <span id="c_board_reconnect">{{ cfg.CONTROL_BOARD_TIME_RECONNECT }}</span>
                    <button onclick="change('c_board_reconnect', 500)">+</button>
                </div>
            </div>
        </div>

        <!-- ОСТАЛЬНЫЕ СИСТЕМНЫЕ НАСТРОЙКИ (ТВОЙ ОРИГИНАЛЬНЫЙ КОД) -->
        <div class="card">
            <h2>Візуалізація</h2>
            <div class="touch-row">
                <span class="label-main">Малювати викл. секції</span>
                <label class="switch">
                    <input type="checkbox" id="c_draw_off" {{ 'checked' if cfg.DRAW_OFF_SECTIONS else '' }}>
                    <span class="slider-round"></span>
                </label>
            </div>
            <div class="touch-row">
                <span class="label-main">Масштаб</span>
                <div class="spinner">
                    <button onclick="change('c_scale', -0.1)">-</button>
                    <span id="c_scale">{{ cfg.VISUAL_SCALE }}</span>
                    <button onclick="change('c_scale', 0.1)">+</button>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Геометрія та Мережа</h2>
            <div class="touch-row">
                <span class="label-main">Offset Back (м)</span>
                <div class="spinner">
                    <button onclick="change('c_off_back', -0.1)">-</button>
                    <span id="c_off_back">{{ cfg.OFFSET_BACK }}</span>
                    <button onclick="change('c_off_back', 0.1)">+</button>
                </div>
            </div>
            <div class="touch-row">
                <span class="label-main">UDP Порт</span>
                <div class="spinner">
                    <button onclick="change('c_port', -1)">-</button>
                    <span id="c_port">{{ cfg.UDP_PORT }}</span>
                    <button onclick="change('c_port', 1)">+</button>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Алгоритм та Швидкість</h2>
            <div class="touch-row">
                <div class="label-box">
                    <span class="label-main">Мін. швидкість (км/год)</span>
                    <span class="label-hint">Нижче цієї швидкості секції вимикаються</span>
                </div>
                <div class="spinner">
                    <button onclick="change('c_min_speed', -0.1)">-</button>
                    <span id="c_min_speed">{{ cfg.MIN_SPEED }}</span>
                    <button onclick="change('c_min_speed', 0.1)">+</button>
                </div>
            </div>
            <div class="touch-row">
                <div class="label-box">
                    <span class="label-main">Мін. винос (м)</span>
                    <span class="label-hint">Мінімальна дистанція перед штангою</span>
                </div>
                <div class="spinner">
                    <button onclick="change('c_min_dist', -0.1)">-</button>
                    <span id="c_min_dist">{{ cfg.MIN_LOOK_AHEAD_DIST }}</span>
                    <button onclick="change('c_min_dist', 0.1)">+</button>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Межі компенсації (%)</h2>
            <div class="touch-row">
                <span class="label-main">Мінімум (внутрішня)</span>
                <div class="spinner">
                    <button onclick="change('c_limit_low', -5)">-</button>
                    <span id="c_limit_low">{{ cfg.CURVE_COMP_LIMITS[0] }}</span>
                    <button onclick="change('c_limit_low', 5)">+</button>
                </div>
            </div>
            <div class="touch-row">
                <span class="label-main">Максимум (зовнішня)</span>
                <div class="spinner">
                    <button onclick="change('c_limit_high', -5)">-</button>
                    <span id="c_limit_high">{{ cfg.CURVE_COMP_LIMITS[1] }}</span>
                    <button onclick="change('c_limit_high', 5)">+</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Фиксированная панель кнопок НАЗАД / СОХРАНИТЬ -->
    <div style="position: fixed; bottom: 0; left: 0; width: 100%; padding: 20px 40px; box-sizing: border-box; display: flex; justify-content: space-between; align-items: center; z-index: 999; pointer-events: none;">
        <button type="button" onclick="goBack()" style="width: 35%; max-width: 250px; background: #2c2c2c; color: #fff; border: 2px solid #444; height: 70px; border-radius: 15px; font-size: 1.4rem; font-weight: bold; cursor: pointer; box-shadow: 0 10px 25px rgba(0,0,0,0.5); pointer-events: auto;">
            НАЗАД
        </button>
        <button type="button" onclick="confirmSave()" style="width: 35%; max-width: 250px; background: var(--accent); color: #000; border: none; height: 70px; border-radius: 15px; font-size: 1.4rem; font-weight: bold; cursor: pointer; box-shadow: 0 10px 25px rgba(0,0,0,0.5); pointer-events: auto;">
            СОХРАНИТЬ
        </button>
    </div>

    <!-- Модалка подтверждения -->
    <div id="customModal">
        <div class="modal-card" id="modalCard">
            <h3 id="modalText" style="margin: 0 0 40px 0; font-size: 28px; color: white; font-weight: bold; line-height: 1.4;">
                Удалить секцию №1?
            </h3>
            <div style="display: flex; gap: 100px; justify-content: center;">
                <button type="button" id="modalCancelBtn" style="flex:1; background:#444; height:90px; font-size:22px; border-radius:15px; border:none; color:white; font-weight:bold; cursor: pointer;">
                    ОТМЕНА
                </button>
                <button type="button" id="modalConfirmBtn" style="flex:1; background:#c0392b; height:90px; font-size:22px; border-radius:15px; border:none; color:white; font-weight:bold; cursor: pointer;">
                    УДАЛИТЬ
                </button>
            </div>
        </div>
    </div>

    <script>
        // Преобразуем строку widths из Jinja в рабочий массив JS
        let widths = [{{ widths }}];

        function askUser(text, theme, confirmText, onConfirm) {
            const modal = document.getElementById('customModal');
            const modalText = document.getElementById('modalText');
            const confirmBtn = document.getElementById('modalConfirmBtn');
            const cancelBtn = document.getElementById('modalCancelBtn');

            modalText.innerHTML = text;
            confirmBtn.innerText = confirmText;

            if (theme === 'danger') {
                confirmBtn.style.background = '#c0392b';
                confirmBtn.style.boxShadow = '0 5px 15px rgba(192, 57, 43, 0.4)';
            } else {
                confirmBtn.style.background = '#2ecc71';
                confirmBtn.style.boxShadow = '0 5px 15px rgba(46, 204, 113, 0.4)';
            }

            modal.style.display = 'flex';

            confirmBtn.onclick = () => {
                onConfirm();
                modal.style.display = 'none';
            };
            cancelBtn.onclick = () => {
                modal.style.display = 'none';
            };
        }

        function openTab(evt, name) {
            if (evt) evt.preventDefault();
            const targetBtn = evt.currentTarget;
            activateTab(targetBtn, name);
        }

        function activateTab(btnElement, name) {
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.tab-link').forEach(l => l.classList.remove('active'));
            document.getElementById(name).classList.add('active');
            if (btnElement) btnElement.classList.add('active');
        }

        function change(id, val) {
            let el = document.getElementById(id);
            let n = parseFloat(el.innerText) + val;
            
            // Защита для портов, статусов и таймеров (только целые числа)
            if (id === 'c_port' || id === 'c_rtk' || id === 'c_gps_reconnect' || id === 'c_board_reconnect' || id === 'c_limit_low' || id === 'c_limit_high') {
                el.innerText = Math.round(n);
            } else {
                el.innerText = n.toFixed(2);
            }
        }

        function updateOverlap(v) { 
            document.getElementById('overlap_label').innerText = Math.round(v * 100) + '%'; 
        }

        function updateSmooth(v) {
            let txt = v < 0.4 ? "Плавно" : (v > 0.7 ? "Мгновенно" : "Норма");
            document.getElementById('smooth_label').innerText = txt;
        }

        function drawSecs() {
            const container = document.getElementById('sec-list');
            container.innerHTML = widths.map((w, i) => `
                <div class="section-item">
                    <button class="btn-del" onclick="removeSection(${i})">×</button>
                    <span style="flex:1">Секція №${i + 1}</span>
                    <div class="spinner">
                        <button onclick="changeW(${i},-0.1)">-</button>
                        <span>${w.toFixed(1)}</span>
                        <button onclick="changeW(${i},0.1)">+</button>
                    </div>
                </div>
            `).join('');
        }

        function changeW(i, v) { 
            widths[i] = Math.max(0.1, widths[i] + v); 
            drawSecs(); 
        }

        function addSec() { 
            widths.push(1.0); 
            drawSecs(); 
        }

        function removeSection(index) {
            askUser(`Видалити секцію №${index + 1}?`, 'danger', 'ВИДАЛИТИ', () => {
                widths.splice(index, 1);
                drawSecs();
            });
        }

        function goBack() {
            window.location.href = '/';
        }

        function confirmSave() {
            askUser(
                'Зберегти зміни?<br><small>Нові параметри будуть застосовані негайно</small>',
                'success',
                'ЗБЕРЕГТИ',
                () => { saveAll(); }
            );
        }

        function saveAll() {
            // Формируем полный объект конфигурации для передачи в Python
            const cfg = {
                SECTION_WIDTHS: widths,
                AUTO_SECTION_MIN_OVERLAP: parseFloat(document.getElementById('c_overlap').value),
                LOOK_AHEAD_TIME: parseFloat(document.getElementById('c_look').innerText),
                AUTO_SECTION_BUFFER: parseFloat(document.getElementById('c_buf').innerText),
                CURVE_COMP_SMOOTH: parseFloat(document.getElementById('c_smooth').value),
                CURVE_COMP_MIN_RTK: parseInt(document.getElementById('c_rtk').innerText),
                DRAW_OFF_SECTIONS: document.getElementById('c_draw_off').checked,
                VISUAL_SCALE: parseFloat(document.getElementById('c_scale').innerText),
                OFFSET_BACK: parseFloat(document.getElementById('c_off_back').innerText),
                UDP_PORT: parseInt(document.getElementById('c_port').innerText),
                MIN_SPEED: parseFloat(document.getElementById('c_min_speed').innerText),
                MIN_LOOK_AHEAD_DIST: parseFloat(document.getElementById('c_min_dist').innerText),
                
                // Сбор новых параметров железа с селекторов и спиннеров
                GPS_ENABLE: document.getElementById('c_gps_enable').checked,
                GPS_PORT: document.getElementById('c_gps_port').value,
                GPS_PORT_SPEED: parseInt(document.getElementById('c_gps_speed').value),
                GPS_TIME_RECONNECT: int(document.getElementById('c_gps_reconnect').innerText),

                CONTROL_BOARD_ENABLE: document.getElementById('c_board_enable').checked,
                CONTROL_BOARD_PORT: document.getElementById('c_board_port').value,
                CONTROL_BOARD_PORT_SPEED: parseInt(document.getElementById('c_board_speed').value),
                CONTROL_BOARD_TIME_RECONNECT: int(document.getElementById('c_board_reconnect').innerText),

                CURVE_COMP_LIMITS: [
                    parseInt(document.getElementById('c_limit_low').innerText),
                    parseInt(document.getElementById('c_limit_high').innerText)
                ]
            };

            fetch('/save_settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(cfg)
            })
            .then(response => {
                if (response.ok) {
                    alert("Налаштування успішно збережені!");
                } else {
                    alert("Помилка збереження. Перевірте зв'язок із сервером.");
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("Сталася помилка при відправці даних.");
            });
        }

        // Первичный рендеринг секций штанги при загрузке
        drawSecs();
    </script>
</body>
</html>
