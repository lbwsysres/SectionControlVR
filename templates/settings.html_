<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Настройки Агро-Системы</title>
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        :root {
            --bg-main: #0a0a0a;
            --bg-card: #181818;
            --accent: #2ecc71;
            --text: #e0e0e0;
            --border: #333;
            --btn-gray: #2c2c2c;
            --danger: #e74c3c;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text);
            font-family: 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            /*padding: 20px 40px;**/
            user-select: none;
            overflow-x: hidden;
            padding: 20px 40px 120px 40px;
            /* Добавили 120px снизу */
        }

        /* Навигация табами */
        .tabs-nav {
            display: flex;
            gap: 5px;
            margin-bottom: 15px;
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--bg-main);
            padding-bottom: 10px;
        }

        .tab-link {
            flex: 1;
            padding: 15px 5px;
            background: var(--bg-card);
            border: 2px solid var(--border);
            color: #666;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: bold;
            transition: 0.2s;
        }

        .tab-link.active {
            border-color: var(--accent);
            color: var(--accent);
            background: #1a2a1f;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Карточки */
        .card {
            background: var(--bg-card);
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid var(--border);
        }

        h2 {
            margin: 0 0 15px 0;
            font-size: 1rem;
            color: #888;
            text-transform: uppercase;
        }

        /* Тач-спиннеры (+ / -) */
        .touch-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .label-box {
            flex: 1;
            padding-right: 10px;
        }

        .label-main {
            display: block;
            font-size: 1rem;
            font-weight: 500;
        }

        .label-hint {
            font-size: 0.8rem;
            color: #666;
        }

        .spinner {
            display: flex;
            align-items: center;
            background: #000;
            border-radius: 10px;
            padding: 4px;
        }

        .spinner button {
            width: 60px;
            height: 60px;
            background: var(--btn-gray);
            border: none;
            color: white;
            font-size: 1.4rem;
            border-radius: 8px;
        }

        .spinner button:active {
            background: #444;
        }

        .spinner span {
            min-width: 60px;
            text-align: center;
            font-size: 1.2rem;
            font-weight: bold;
        }

        /* Большой слайдер */
        .slider-box {
            margin-bottom: 20px;
        }

        .slider {
            -webkit-appearance: none;
            width: 100%;
            height: 40px;
            background: #222;
            border-radius: 20px;
            outline: none;
            margin-top: 10px;
        }

        .slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 40px;
            height: 40px;
            background: var(--accent);
            border-radius: 50%;
            border: 3px solid #fff;
        }

        /* Список секций */
        .section-item {
            display: flex;
            align-items: center;
            background: #222;
            margin-bottom: 8px;
            padding: 8px;
            border-radius: 10px;
            gap: 10px;
        }

        .btn-del {
            width: 45px;
            height: 45px;
            background: var(--danger);
            color: white;
            border: none;
            border-radius: 8px;
        }

        /* Переключатель (Toggle) */
        .switch {
            position: relative;
            display: inline-block;
            width: 80px;
            height: 34px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider-round {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #333;
            transition: .4s;
            border-radius: 34px;
        }

        .slider-round:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }

        input:checked+.slider-round {
            background-color: var(--accent);
        }

        input:checked+.slider-round:before {
            transform: translateX(26px);
        }

        .btn-save {
            background: var(--accent);
            color: #000;
            border: none;
            width: 100%;
            padding: 20px;
            border-radius: 15px;
            font-size: 1.2rem;
            font-weight: bold;
            margin-top: 10px;
        }

        input:checked+.slider-round {
            background-color: var(--accent);
        }

        input:checked+.slider-round:before {
            transform: translateX(36px);
        }

        #customModal {
            display: none;
            /* Прячем по умолчанию */
            position: fixed;
            /* Фиксируем поверх всего */
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            /* Темный фон */
            z-index: 9999;
            /* Самый верхний слой */
            justify-content: center;
            /* Центровка по горизонтали */
            align-items: center;
            /* Центровка по вертикали */
        }

        /* Сама карточка окна */
        .modal-card {
            background: #1e1e1e;
            width: 80%;
            max-width: 500px;
            padding: 30px;
            border-radius: 20px;
            border-top: 8px solid #c0392b;
            /* По умолчанию красная */
            text-align: center;
            box-shadow: 0 10px 50px rgba(0, 0, 0, 0.8);
        }

        .btn-back {
            display: flex;
            align-items: center;
            justify-content: center;
            background: #333;
            /* Темно-сірий колір */
            color: #aaa;
            /* Світло-сірий текст */
            text-decoration: none;
            /* Прибираємо підкреслення */
            padding: 20px;
            margin: 20px auto;
            border-radius: 12px;
            font-size: 20px;
            font-weight: bold;
            width: 100%;
            /* На всю ширину контейнера (70%) */
            box-sizing: border-box;
            border: 1px solid #444;
            transition: background 0.2s;
        }

        .btn-back:active {
            background: #444;
            /* Ефект натискання */
            color: #fff;
        }
    </style>
</head>

<body>

    <body>
        <div class="tabs-nav">
            <button class="tab-link active" onclick="openTab(event, 'tab1')">ШТАНГА</button>
            <button class="tab-link" onclick="openTab(event, 'tab2')">АВТО</button>
            <button class="tab-link" onclick="openTab(event, 'tab3')">GPS</button>
            <button class="tab-link" onclick="openTab(event, 'tab3')">BOARD</button>
            <button class="tab-link" onclick="openTab(event, 'tab3')">СИСТЕМА</button>
        </div>

        <!-- ТАБ 1: ШТАНГА -->
        <div id="tab1" class="tab-content active">
            <div class="card">
                <h2>Конфігурація секцій (м)</h2>
                <div id="sec-list"></div>
                <!-- button onclick="addSec()" class="btn-add">+ ДОДАТИ СЕКЦІЮ</button -->
                <button onclick="addSec()"
                    style="width:100%; padding:15px; background:transparent; color:var(--accent); border:2px dashed var(--accent); border-radius:10px; margin-top:10px;">
                    + ДОБАВИТЬ СЕКЦИЮ
                </button>
            </div>
        </div>

        <!-- ТАБ 2: АВТОМАТИКА -->
        <div id="tab2" class="tab-content">
            <div class="card">
                <h2>Перекриття</h2>
                <div class="slider-box">
                    <div class="touch-row">
                        <span class="label-main">Мінімальне перекриття</span>
                        <b id="overlap_label" style="color:var(--accent)">{{ (cfg.AUTO_SECTION_MIN_OVERLAP * 100)|int
                            }}%</b>
                    </div>
                    <!-- Підставляємо значення в value слайдера -->
                    <input type="range" class="slider" id="c_overlap" min="0" max="1" step="0.05"
                        value="{{ cfg.AUTO_SECTION_MIN_OVERLAP }}" oninput="updateOverlap(this.value)">
                </div>

                <div class="touch-row">
                    <span class="label-main">Look Ahead (сек)</span>
                    <div class="spinner">
                        <button onclick="change('c_look', -0.1)">-</button>
                        <span id="c_look">{{ cfg.LOOK_AHEAD_TIME }}</span>
                        <button onclick="change('c_look', 0.1)">+</button>
                    </div>
                </div>

                <div class="touch-row">
                    <span class="label-main">Buffer (м)</span>
                    <div class="spinner">
                        <button onclick="change('c_buf', -0.01)">-</button>
                        <span id="c_buf">{{ cfg.AUTO_SECTION_BUFFER }}</span>
                        <button onclick="change('c_buf', 0.01)">+</button>
                    </div>
                </div>
            </div>

            <div class="card">
                <h2>Криві та RTK</h2>
                <div class="slider-box">
                    <div class="touch-row">
                        <span class="label-main">Плавність фільтра</span>
                        <b id="smooth_label" style="color:var(--accent)">{{ cfg.CURVE_COMP_SMOOTH }}</b>
                    </div>
                    <input type="range" class="slider" id="c_smooth" min="0.1" max="1" step="0.1"
                        value="{{ cfg.CURVE_COMP_SMOOTH }}" oninput="updateSmooth(this.value)">
                </div>

                <div class="touch-row">
                    <span class="label-main">Мін. RTK статус</span>
                    <div class="spinner">
                        <button onclick="change('c_rtk', -1)">-</button>
                        <span id="c_rtk">{{ cfg.CURVE_COMP_MIN_RTK }}</span>
                        <button onclick="change('c_rtk', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ТАБ 3: СИСТЕМА -->
        <div id="tab3" class="tab-content">
            <div class="card">
                <h2>Візуалізація</h2>
                <div class="touch-row">
                    <span class="label-main">Малювати викл. секції</span>
                    <label class="switch">
                        <!-- Використовуємо тернарний оператор Jinja для checkbox -->
                        <input type="checkbox" id="c_draw_off" {{ 'checked' if cfg.DRAW_OFF_SECTIONS else '' }}>
                        <span class="slider-round"></span>
                    </label>
                </div>
                <div class="touch-row">
                    <span class="label-main">Масштаб</span>
                    <div class="spinner">
                        <button onclick="change('c_scale', -0.1)">-</button>
                        <span id="c_scale">{{ cfg.VISUAL_SCALE }}</span>
                        <button onclick="change('c_scale', 0.1)">+</button>
                    </div>
                </div>
            </div>

            <div class="card">
                <h2>Геометрія та Мережа</h2>
                <div class="touch-row">
                    <span class="label-main">Offset Back (м)</span>
                    <div class="spinner">
                        <button onclick="change('c_off_back', -0.1)">-</button>
                        <span id="c_off_back">{{ cfg.OFFSET_BACK }}</span>
                        <button onclick="change('c_off_back', 0.1)">+</button>
                    </div>
                </div>
                <div class="touch-row">
                    <span class="label-main">UDP Порт</span>
                    <div class="spinner">
                        <button onclick="change('c_port', -1)">-</button>
                        <span id="c_port">{{ cfg.UDP_PORT }}</span>
                        <button onclick="change('c_port', 1)">+</button>
                    </div>
                </div>
            </div>
            <div class="card">
                <h2>Алгоритм та Швидкість</h2>
                <div class="touch-row">
                    <div class="label-box">
                        <span class="label-main">Мін. швидкість (км/год)</span>
                        <span class="label-hint">Нижче цієї швидкості секції вимикаються</span>
                    </div>
                    <div class="spinner">
                        <button onclick="change('c_min_speed', -0.1)">-</button>
                        <span id="c_min_speed">{{ cfg.MIN_SPEED }}</span>
                        <button onclick="change('c_min_speed', 0.1)">+</button>
                    </div>
                </div>
                <div class="touch-row">
                    <div class="label-box">
                        <span class="label-main">Мін. винос (м)</span>
                        <span class="label-hint">Мінімальна дистанція перед штангою</span>
                    </div>
                    <div class="spinner">
                        <button onclick="change('c_min_dist', -0.1)">-</button>
                        <span id="c_min_dist">{{ cfg.MIN_LOOK_AHEAD_DIST }}</span>
                        <button onclick="change('c_min_dist', 0.1)">+</button>
                    </div>
                </div>
            </div>

            <div class="card">
                <h2>Межі компенсації (%)</h2>
                <div class="touch-row">
                    <span class="label-main">Мінімум (внутрішня)</span>
                    <div class="spinner">
                        <button onclick="change('c_limit_low', -5)">-</button>
                        <span id="c_limit_low">{{ cfg.CURVE_COMP_LIMITS[0] }}</span>
                        <button onclick="change('c_limit_low', 5)">+</button>
                    </div>
                </div>
                <div class="touch-row">
                    <span class="label-main">Максимум (зовнішня)</span>
                    <div class="spinner">
                        <button onclick="change('c_limit_high', -5)">-</button>
                        <span id="c_limit_high">{{ cfg.CURVE_COMP_LIMITS[1] }}</span>
                        <button onclick="change('c_limit_high', 5)">+</button>
                    </div>
                </div>
            </div>

        </div>

        <!-- button class="btn-save" onclick="saveAll()">ЗБЕРЕГТИ ВСЕ</button -->

        <!-- Фиксированная панель: разносит кнопки по краям экрана -->
        <div
            style="position: fixed; bottom: 0; left: 0; width: 100%; padding: 20px 40px; box-sizing: border-box; display: flex; justify-content: space-between; align-items: center; z-index: 999; pointer-events: none;">
            <!-- Кнопка НАЗАД (слева, pointer-events возвращен для кликов) -->
            <button type="button" onclick="goBack()"
                style="width: 35%; max-width: 250px; background: #2c2c2c; color: #fff; border: 2px solid #444; height: 70px; border-radius: 15px; font-size: 1.4rem; font-weight: bold; cursor: pointer; box-shadow: 0 10px 25px rgba(0,0,0,0.5); pointer-events: auto;">
                НАЗАД
            </button>

            <!-- Кнопка ЗБЕРЕГТИ ВСЕ (справа, pointer-events возвращен для кликов) -->
            <button type="button" onclick="confirmSave()"
                style="width: 35%; max-width: 250px; background: var(--accent); color: #000; border: none; height: 70px; border-radius: 15px; font-size: 1.4rem; font-weight: bold; cursor: pointer; box-shadow: 0 10px 25px rgba(0,0,0,0.5); pointer-events: auto;">
                СОХРАНИТЬ
            </button>
        </div>


        <div id="customModal" style="display:none; ...">
            <div class="modal-card" id="modalCard"
                style="background:#1e1e1e; width:80%; max-width:500px; padding:40px 30px; border-radius:20px; border-top:8px solid #c0392b; text-align:center; box-shadow: 0 10px 50px rgba(0,0,0,0.8);">

                <!-- Текст теперь точно по центру -->
                <h3 id="modalText"
                    style="margin: 0 0 40px 0; font-size: 28px; color: white; font-weight: bold; line-height: 1.4;">
                    Удалить секцию №1?
                </h3>

                <div style="display: flex; gap: 100px; justify-content: center;">
                    <button type="button" id="modalCancelBtn" class="btn-step"
                        style="flex:1; background:#444; height:90px; font-size:22px; border-radius:15px; border:none; color:white; font-weight:bold;">
                        ОТМЕНА
                    </button>
                    <button type="button" id="modalConfirmBtn" class="btn-step"
                        style="flex:1; background:#c0392b; height:90px; font-size:22px; border-radius:15px; border:none; color:white; font-weight:bold;">
                        УДАЛИТЬ
                    </button>
                </div>
            </div>
        </div>
        <script>
            /**
         * Вызывает модальное окно
         * @param {string} text - Заголовок (вопрос)
         * @param {string} theme - 'danger' (красный) или 'success' (зеленый)
         * @param {string} confirmText - Текст на кнопке действия
         * @param {function} onConfirm - Функция, которая выполнится при нажатии
         */
            function askUser(text, theme, confirmText, onConfirm) {
                const modal = document.getElementById('customModal');
                const modalText = document.getElementById('modalText');
                const confirmBtn = document.getElementById('modalConfirmBtn'); // Твоя кнопка "Да"
                const cancelBtn = document.getElementById('modalCancelBtn');   // Твоя кнопка "Отмена"

                // 1. Устанавливаем текст
                //modalText.innerText = text;
                modalText.innerHTML = text;
                confirmBtn.innerText = confirmText;

                // 2. Меняем оформление в зависимости от темы
                if (theme === 'danger') {
                    confirmBtn.style.background = '#c0392b'; // Красный
                    confirmBtn.style.boxShadow = '0 5px 15px rgba(192, 57, 43, 0.4)';
                } else {
                    confirmBtn.style.background = '#2ecc71'; // Зеленый
                    confirmBtn.style.boxShadow = '0 5px 15px rgba(46, 204, 113, 0.4)';
                }

                // 3. Показываем окно
                modal.style.display = 'flex';

                confirmBtn.onclick = null;
                // 4. Вешаем обработчики (сначала чистим старые)
                confirmBtn.onclick = () => {
                    onConfirm();
                    modal.style.display = 'none';
                };

                cancelBtn.onclick = () => {
                    modal.style.display = 'none';
                };
            }

            function changeVal(id, step) {
                const el = document.getElementById(id);
                let val = parseFloat(el.value) || 0;
                el.value = (val + step).toFixed(1);
            }
            function setToggle(val) {
                document.getElementById('draw_off_val').value = val ? 'true' : 'false';
                document.getElementById('btn_yes').className = val ? 'toggle-btn active' : 'toggle-btn';
                document.getElementById('btn_no').className = !val ? 'toggle-btn active' : 'toggle-btn';
            }

            // Инициализация при загрузке: берем строку "1.0,1.0" и превращаем в кнопки
            let sections = [{{ widths }}];

            function renderSections() {
                const container = document.getElementById('sections_container');
                container.innerHTML = '';

                sections.forEach((w, index) => {
                    const row = document.createElement('div');
                    row.className = 'input-row';
                    row.style.marginBottom = '10px';
                    row.innerHTML = `
                <span style="width: 30px; color: #666;">${index + 1}</span>
                <button type="button" class="btn-step" style="background: #c0392b;" onclick="removeSection(${index})">×</button>
                <input type="number" step="0.1" value="${w.toFixed(1)}" readonly style="background: transparent;">
                <button type="button" class="btn-step" style="width: 75px;" onclick="updateWidth(${index}, -0.1)">-</button>
                <button type="button" class="btn-step" style="width: 75px;" onclick="updateWidth(${index}, 0.1)">+</button>
            `;
                    container.appendChild(row);
                });

                // Обновляем скрытое поле для отправки серверу
                document.getElementById('widths_input').value = sections.map(s => s.toFixed(1)).join(',');
            }
            // Перетворюємо рядок widths назад у масив JS
            let widths = [{{ widths }}];


            function removeSection(index) {
                askUser(`Видалити секцію №${index + 1}?`, 'danger', 'ВИДАЛИТИ', () => {
                    widths.splice(index, 1);
                    drawSecs();
                });
            }

            function openTab(evt, name) {
                // Зупиняємо стандартну обробку кліку, щоб вікно не глючило
                if (evt) evt.preventDefault();
                // Зберігаємо посилання на кнопку, на яку натиснули
                const targetBtn = evt.currentTarget;

                if (name === 'tab9') {
                    askUser('Вхід у системні налаштування<br><small>Тільки для інженерів</small>', 'success', 'ПЕРЕЙТИ', () => {
                        // Викликаємо активацію, передаючи збережену кнопку замість події
                        activateTab(targetBtn, name);
                    });
                    return;
                }
                activateTab(targetBtn, name);
            }

            function activateTab(btnElement, name) {
                // 1. Ховаємо всі контенти
                document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                // 2. Знімаємо підсвітку з усіх кнопок табів
                document.querySelectorAll('.tab-link').forEach(l => l.classList.remove('active'));
                // 3. Показуємо потрібний контент і підсвічуємо кнопку
                document.getElementById(name).classList.add('active');
                if (btnElement) btnElement.classList.add('active');
            }

            function change(id, val) {
                let el = document.getElementById(id);
                let n = parseFloat(el.innerText) + val;
                el.innerText = (id === 'c_port' || id === 'c_rtk') ? Math.round(n) : n.toFixed(2);
            }

            function updateOverlap(v) { document.getElementById('overlap_label').innerText = Math.round(v * 100) + '%'; }
            function updateSmooth(v) {
                let txt = v < 0.4 ? "Плавно" : (v > 0.7 ? "Мгновенно" : "Норма");
                document.getElementById('smooth_label').innerText = txt;
            }

            function drawSecs() {
                const container = document.getElementById('sec-list');
                container.innerHTML = widths.map((w, i) => `
                <div class="section-item">
                    <button class="btn-del" onclick="removeSection(${i})">×</button>
                    <span style="flex:1">Секція №${i + 1}</span>
                    <div class="spinner">
                        <button onclick="changeW(${i},-0.1)">-</button>
                        <span>${w.toFixed(1)}</span>
                        <button onclick="changeW(${i},0.1)">+</button>
                    </div>
                </div>
            `).join('');
            }

            function changeW(i, v) { widths[i] = Math.max(0.1, widths[i] + v); drawSecs(); }
            function addSec() { widths.push(1.0); drawSecs(); }
            function delSec(i) { widths.splice(i, 1); drawSecs(); }

            function confirmSave() {
                askUser(
                    'Зберегти зміни?<br><small>Нові параметри будуть застосовані негайно</small>',
                    'success', // Зеленая тема окна
                    'ЗБЕРЕГТИ', // Текст на кнопке подтверждения
                    () => {
                        saveAll(); // Если нажали "ЗБЕРЕГТИ" — запускаем твою функцию отправки на сервер
                    }
                );
            }
            function goBack() {
                // Просто перенаправляем на главный экран курсоуказателя
                window.location.href = '/';
            }
            function saveAll() {
                const cfg = {
                    SECTION_WIDTHS: widths, // масив значень ширини секцій
                    AUTO_SECTION_MIN_OVERLAP: parseFloat(document.getElementById('c_overlap').value),
                    LOOK_AHEAD_TIME: parseFloat(document.getElementById('c_look').innerText),
                    AUTO_SECTION_BUFFER: parseFloat(document.getElementById('c_buf').innerText),
                    CURVE_COMP_SMOOTH: parseFloat(document.getElementById('c_smooth').value),
                    CURVE_COMP_MIN_RTK: parseInt(document.getElementById('c_rtk').innerText),
                    DRAW_OFF_SECTIONS: document.getElementById('c_draw_off').checked,
                    VISUAL_SCALE: parseFloat(document.getElementById('c_scale').innerText),
                    OFFSET_BACK: parseFloat(document.getElementById('c_off_back').innerText),
                    UDP_PORT: parseInt(document.getElementById('c_port').innerText),

                    MIN_SPEED: parseFloat(document.getElementById('c_min_speed').innerText),
                    MIN_LOOK_AHEAD_DIST: parseFloat(document.getElementById('c_min_dist').innerText),
                    CURVE_LIMIT_LOW: parseInt(document.getElementById('c_limit_low').innerText),
                    CURVE_LIMIT_HIGH: parseInt(document.getElementById('c_limit_high').innerText)
                };

                fetch('/save_settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(cfg)
                })
                    .then(response => {
                        if (response.ok) {
                            alert("Налаштування успішно збережені!");
                            // location.reload(); // Розкоментуйте, якщо потрібно оновити сторінку
                        } else {
                            alert("Помилка збереження. Перевірте зв'язок із сервером.");
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert("Сталася помилка при відправці даних.");
                    });
            }


            drawSecs();
        </script>
    </body>

</html>